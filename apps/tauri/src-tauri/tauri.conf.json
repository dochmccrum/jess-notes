{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jess Notes",
  "identifier": "app.jessnotes.notes",
  "build": {
    "frontendDist": "../../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jess Notes",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: jess-blob: http://jess-blob.localhost",
        "media-src": "'self' blob: jess-blob: http://jess-blob.localhost",
        "connect-src": "ipc: http://ipc.localhost jess-blob: http://jess-blob.localhost",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first markdown notes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libnss3", "libgbm1", "libxkbcommon0", "libasound2t64 | libasound2", "libcups2t64 | libcups2", "libatk-bridge2.0-0t64 | libatk-bridge2.0-0", "libxcomposite1", "libxdamage1", "libxrandr2", "libdrm2"],
        "files": { "/usr/lib/jess-notes/": "../cef/dist/", "/etc/apparmor.d/jess-notes": "../cef/apparmor-profile" },
        "postInstallScript": "../cef/postinst.sh"
      },
      "appimage": { "files": { "/usr/lib/jess-notes/": "../cef/dist/" } }
    }
  }
}
